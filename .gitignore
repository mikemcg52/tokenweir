.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Coverage artifacts. `.coverage.*` is a separate pattern from `.coverage` — it
# matches the per-process data files coverage writes in parallel mode. coverage.xml
# is listed because mado/config.yaml declares `coverage.format: xml` for this
# project, so a MADO run produces it.
.coverage
.coverage.*
htmlcov/
coverage.xml

# Distribution output. Added by TOKWEIR-5, which builds a wheel to confirm the
# migrations travel in it as package data — setuptools leaves a `build/` behind
# when it does. Same reasoning as the coverage rules above: `tokenweir` is the
# intended first open-source release (ADR-0001 Pillar 1), and regenerable build
# output carrying absolute developer paths must not be one `git add -A` away from
# the tree.
build/
dist/

# Virtualenvs (the MADO stream plan builds .venv at /workspace/repo/.venv)
.venv/
venv/
